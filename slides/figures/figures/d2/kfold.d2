direction: down

explanation: "Each fold takes a turn as the test set.\nThis gives 5 independent estimates of model performance." {
  style.fill: "#F7F7F5"
  style.stroke: "#F7F7F5"
  style.font-color: "#767676"
  style.font-size: 14
}

runs: "" {
  grid-rows: 5
  grid-columns: 5
  grid-gap: 6

  r1c1: "TEST" { style.fill: "#3D6B8E"; style.font-color: "#F7F7F5"; style.border-radius: 3 }
  r1c2: "train" { style.fill: "#EFEFED"; style.stroke: "#767676"; style.border-radius: 3; style.font-color: "#767676" }
