direction: right

data: "Raw Data" {
  style.fill: "#EFEFED"
  style.stroke: "#767676"
  style.border-radius: 4
}
split: "Train / Test\nSplit" {
  style.fill: "#EFEFED"
  style.stroke: "#3D6B8E"
  style.border-radius: 4
}
scale: "Scale\nStandardScaler" {
  style.fill: "#EFEFED"
  style.stroke: "#3D6B8E"
  style.border-radius: 4
}
fit: "Fit Model\ne.g. KNN" {
  style.fill: "#EFEFED"
  style.stroke: "#3D6B8E"
  style.border-radius: 4
}
predict: "Predict" {
  style.fill: "#EFEFED"
  style.stroke: "#3D6B8E"
  style.border-radius: 4
}
evaluate: "Evaluate\nconfusion matrix\nMSE · R²" {
  style.fill: "#3D6B8E"
  style.stroke: "#3D6B8E"
  style.font-color: "#F7F7F5"
  style.border-radius: 4
}

data -> split: {style.stroke: "#767676"}
split -> scale: {style.stroke: "#3D6B8E"}
scale -> fit: {style.stroke: "#3D6B8E"}
fit -> predict: {style.stroke: "#3D6B8E"}
predict -> evaluate: {style.stroke: "#3D6B8E"}
