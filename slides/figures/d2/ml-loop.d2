direction: right

understand: "Understand\nthe Problem" {
  style.fill: "#EFEFED"
  style.stroke: "#3D6B8E"
  style.border-radius: 4
}
explore: "Explore\nthe Data" {
  style.fill: "#EFEFED"
  style.stroke: "#3D6B8E"
  style.border-radius: 4
}
build: "Build\nthe Model" {
  style.fill: "#EFEFED"
  style.stroke: "#3D6B8E"
  style.border-radius: 4
}
evaluate: "Evaluate\nPerformance" {
  style.fill: "#EFEFED"
  style.stroke: "#3D6B8E"
  style.border-radius: 4
}
improve: "Improve\n& Iterate" {
  style.fill: "#3D6B8E"
  style.stroke: "#3D6B8E"
  style.font-color: "#F7F7F5"
  style.border-radius: 4
}

understand -> explore: {style.stroke: "#3D6B8E"}
explore -> build: {style.stroke: "#3D6B8E"}
build -> evaluate: {style.stroke: "#3D6B8E"}
evaluate -> improve: {style.stroke: "#3D6B8E"}
improve -> understand: {style.stroke: "#3D6B8E"}
