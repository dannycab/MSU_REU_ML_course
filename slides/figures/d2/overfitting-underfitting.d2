direction: right

# Three model-complexity regimes, left -> right.
# Read the error rows top-to-bottom across the boxes:
#   training error falls monotonically (HIGH -> LOW -> ~0)
#   test error is U-shaped (HIGH -> LOWEST -> HIGH)  <- the whole point

underfit: "Underfitting" {
  direction: down
  style.fill: "#FADBD8"
  style.stroke: "#C46E3A"
  style.border-radius: 8

  cause: "Model too simple" {
    style.fill: transparent
    style.stroke: transparent
    style.font-color: "#1C1C1C"
  }
  errs: "Training error: HIGH\nTest error: HIGH" {
    style.fill: "#FFFFFF"
    style.stroke: "#C46E3A"
    style.border-radius: 4
  }
  diag: "High bias\n(Fails to\ncapture signal)" {
    style.fill: "#C46E3A"
    style.stroke: "#C46E3A"
    style.font-color: "#F7F7F5"
    style.border-radius: 4
  }
}

goldilocks: "Just Right — Goldilocks Zone" {
  direction: down
  style.fill: "#D5F4E6"
  style.stroke: "#2E8B57"
  style.border-radius: 8

  cause: "Captures signal, ignores noise" {
    style.fill: transparent
    style.stroke: transparent
    style.font-color: "#1C1C1C"
  }
  errs: "Training error: LOW\nTest error: LOWEST" {
    style.fill: "#FFFFFF"
    style.stroke: "#2E8B57"
    style.border-radius: 4
  }
  diag: "Balanced bias & variance" {
    style.fill: "#2E8B57"
    style.stroke: "#2E8B57"
    style.font-color: "#F7F7F5"
    style.border-radius: 4
  }
}

overfit: "Overfitting" {
  direction: down
  style.fill: "#FADBD8"
  style.stroke: "#C46E3A"
  style.border-radius: 8

  cause: "Model memorizes noise" {
    style.fill: transparent
    style.stroke: transparent
    style.font-color: "#1C1C1C"
  }
  errs: "Training error: ~0\nTest error: HIGH" {
    style.fill: "#FFFFFF"
    style.stroke: "#C46E3A"
    style.border-radius: 4
  }
  diag: "High variance\n(Fails to\ngeneralize)" {
    style.fill: "#C46E3A"
    style.stroke: "#C46E3A"
    style.font-color: "#F7F7F5"
    style.border-radius: 4
  }
}

arrow1: "increasing model complexity →" {
  style.fill: "#E8F1FA"
  style.stroke: "#3D6B8E"
  style.font-color: "#3D6B8E"
  style.border-radius: 6
}

arrow2: "increasing model complexity →" {
  style.fill: "#E8F1FA"
  style.stroke: "#3D6B8E"
  style.font-color: "#3D6B8E"
  style.border-radius: 6
}

underfit -> arrow1 -> goldilocks
goldilocks -> arrow2 -> overfit
