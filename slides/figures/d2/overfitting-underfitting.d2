# Bias-Variance Tradeoff: Model Complexity vs Generalization

direction: right

plot: "Model Complexity vs Error" {
  style.fill: "#f9f9f9"
  style.stroke: "#767676"
  style.border-radius: 6

  axes: "" {
    style.fill: "transparent"
    style.stroke: "transparent"
  }

  # Regions
  underfit_zone: "Underfitting\n(too simple)" {
    style.fill: "#fadbd8"
    style.stroke: "transparent"
    style.border-radius: 4
  }

  goldilocks: "Goldilocks Zone\n(just right)" {
    style.fill: "#d5f4e6"
    style.stroke: "transparent"
    style.border-radius: 4
  }

  overfit_zone: "Overfitting\n(too complex)" {
    style.fill: "#fadbd8"
    style.stroke: "transparent"
    style.border-radius: 4
  }

  # Curve elements
  train_curve: "Training Error\n(decreases)" {
    style.fill: "transparent"
    style.stroke: "#3D6B8E"
    style.stroke-width: 2
    style.font-color: "#3D6B8E"
  }

  test_curve: "Test Error\n(increases)" {
    style.fill: "transparent"
    style.stroke: "#C46E3A"
    style.stroke-width: 2
    style.font-color: "#C46E3A"
  }
}

# Explanation
explanation: "Underfitting: Model too simple, high bias\nOverfitting: Model memorizes noise, high variance\nGoal: Balance bias and variance for best generalization" {
  style.fill: "#fff9e6"
  style.stroke: "#C46E3A"
  style.font-color: "#1C1C1C"
  style.border-radius: 4
  style.stroke-width: 2
}
