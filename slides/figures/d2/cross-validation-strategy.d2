# K-Fold Cross-Validation: Multiple train/test splits

direction: right

# Data
data: "Full Dataset" {
  style.fill: "#c8e6f5"
  style.stroke: "#3D6B8E"
  style.border-radius: 6
  style.stroke-width: 2
  width: 140
  height: 80
}

data -> split: {style.stroke: "#767676"; style.stroke-width: 2}

split: "Split into\nK folds\n(e.g., k=5)" {
  style.fill: "transparent"
  style.stroke: "#767676"
  style.border-radius: 6
  style.stroke-width: 2
  width: 140
  height: 80
}

split -> fold1: {style.stroke: "#767676"}
split -> fold2: {style.stroke: "#767676"}
split -> fold3: {style.stroke: "#767676"}

fold1: "Fold 1\nTest: 20%\nTrain: 80%" {
  style.fill: "transparent"
  style.stroke: "#C46E3A"
  style.border-radius: 6
  style.stroke-width: 2
  width: 140
  height: 80
}

fold2: "Fold 2\nTest: 20%\nTrain: 80%" {
  style.fill: "transparent"
  style.stroke: "#C46E3A"
  style.border-radius: 6
  style.stroke-width: 2
  width: 140
  height: 80
}

fold3: "Fold 3...\n(repeats)" {
  style.fill: "transparent"
  style.stroke: "#C46E3A"
  style.border-radius: 6
  style.stroke-width: 2
  width: 140
  height: 80
}

fold1 -> train: {style.stroke: "#C46E3A"}
fold2 -> train: {style.stroke: "#C46E3A"}
fold3 -> train: {style.stroke: "#C46E3A"}

train: "Train & Evaluate\nk times" {
  style.fill: "transparent"
  style.stroke: "#3D6B8E"
  style.border-radius: 6
  style.stroke-width: 2
  width: 140
  height: 80
}

train -> average: {style.stroke: "#3D6B8E"; style.stroke-width: 2}

average: "Average Results\nR² = (r2_1 + r2_2 + r2_3) / 3\nMore robust estimate" {
  style.fill: "#d5f4e6"
  style.stroke: "#5E9E7E"
  style.border-radius: 6
  style.stroke-width: 2
  width: 180
  height: 100
}

# Benefit
benefit: "Benefit: One lucky split → k estimates\nReduces variance in performance estimate" {
  style.fill: "#fff9e6"
  style.stroke: "#C46E3A"
  style.font-color: "#1C1C1C"
  style.border-radius: 4
  style.stroke-width: 1
}
