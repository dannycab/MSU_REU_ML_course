grid: "Why Rescale?" {
  grid-rows: 4
  grid-columns: 3

  h1: "Feature" {
    style.fill: "#3D6B8E"
    style.font-color: white
    style.bold: true
  }
  h2: "Unscaled σ" {
    style.fill: "#C46E3A"
    style.font-color: white
    style.bold: true
  }
  h3: "Scaled σ" {
    style.fill: "#5E9E7E"
    style.font-color: white
    style.bold: true
  }

  f_big: "Photometry\nu, g, z"
  b_big: "~31.7  ← large" { style.fill: "#fadbd8" }
  a_big: "1.0" { style.fill: "#d5f4e6" }

  f_small: "Photometry\ni, z"
  b_small: "1.8  ← small" { style.fill: "#fdebd0" }
  a_small: "1.0" { style.fill: "#d5f4e6" }

  f_rs: "Redshift"
  b_rs: "0.73  ← small" { style.fill: "#fdebd0" }
  a_rs: "1.0" { style.fill: "#d5f4e6" }
}
