# Model Comparison: Linear Regression vs Random Forest

direction: down

grid: "Linear vs Random Forest Regression" {
  grid-rows: 5
  grid-columns: 3

  h1: "Criterion" {
    style.fill: "#767676"
    style.font-color: white
    style.bold: true
  }
  h2: "Linear Regression" {
    style.fill: "#3D6B8E"
    style.font-color: white
    style.bold: true
  }
  h3: "Random Forest" {
    style.fill: "#5E9E7E"
    style.font-color: white
    style.bold: true
  }

  c1: "Speed" {
    style.fill: "#f0f0f0"
  }
  s1: "Fast ✓" {
    style.fill: "#d5f4e6"
  }
  s2: "Slower ✗" {
    style.fill: "#fadbd8"
  }

  c2: "Interpretability" {
    style.fill: "#f0f0f0"
  }
  i1: "High\n(see β coefficients)" {
    style.fill: "#d5f4e6"
  }
  i2: "Low\n(black box)" {
    style.fill: "#fadbd8"
  }

  c3: "Flexibility" {
    style.fill: "#f0f0f0"
  }
  f1: "Low\n(straight line)" {
    style.fill: "#fadbd8"
  }
  f2: "High\n(curves & interactions)" {
    style.fill: "#d5f4e6"
  }

  c4: "Overfitting Risk" {
    style.fill: "#f0f0f0"
  }
  o1: "Low" {
    style.fill: "#d5f4e6"
  }
  o2: "High\n(needs tuning)" {
    style.fill: "#fadbd8"
  }
}
