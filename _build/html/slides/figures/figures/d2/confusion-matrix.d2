matrix: "" {
  grid-rows: 2
  grid-columns: 2
  grid-gap: 12

  tp: "True Positive (TP)\nSaid YES · Was YES ✓" {
    style.fill: "#D4E6D4"
    style.stroke: "#3D6B8E"
    style.border-radius: 4
    style.font-size: 16
  }
  fp: "False Positive (FP)\nSaid YES · Was NO ✗" {
    style.fill: "#EDD4D4"
    style.stroke: "#8E3D3D"
    style.border-radius: 4
    style.font-size: 16
  }
  fn: "False Negative (FN)\nSaid NO · Was YES ✗" {
    style.fill: "#EDD4D4"
    style.stroke: "#8E3D3D"
    style.border-radius: 4
    style.font-size: 16
  }
  tn: "True Negative (TN)\nSaid NO · Was NO ✓" {
    style.fill: "#D4E6D4"
    style.stroke: "#3D6B8E"
    style.border-radius: 4
    style.font-size: 16
  }
}
